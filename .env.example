# URL del proyecto Supabase (utilizada por el cliente frontend y backend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clave pública anónima de Supabase para consultas con RLS desde el navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clave con privilegios de service role de Supabase (exclusiva del backend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL base canónica de la aplicación (para redirecciones de auth y correos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clave de API de Google Gemini para las funciones del asistente IA y selección
GEMINI_API_KEY=your-gemini-api-key

# Modelo de Google Gemini utilizado en el procesamiento de prompts
GEMINI_MODEL=gemini-2.5-flash

# Clave de API de Resend para el envío transaccional de correos electrónicos
RESEND_API_KEY=your-resend-api-key

# Flag para habilitar o deshabilitar el envío real de notificaciones por email
EMAIL_POSTULACIONES_HABILITADO=false

# URL base utilizada por Playwright para ejecutar los tests de integración E2E
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Email del usuario con rol POSTULANTE para la suite de pruebas E2E
E2E_POSTULANTE_EMAIL=postulante@example.com

# Contraseña del usuario con rol POSTULANTE para la suite de pruebas E2E
E2E_POSTULANTE_PASSWORD=password-placeholder

# Email del usuario con rol RECLUTADOR para la suite de pruebas E2E
E2E_RECLUTADOR_EMAIL=reclutador@example.com

# Contraseña del usuario con rol RECLUTADOR para la suite de pruebas E2E
E2E_RECLUTADOR_PASSWORD=password-placeholder

# Email del usuario con rol ADMIN para la suite de pruebas E2E
E2E_ADMIN_EMAIL=admin@example.com

# Contraseña del usuario con rol ADMIN para la suite de pruebas E2E
E2E_ADMIN_PASSWORD=password-placeholder
